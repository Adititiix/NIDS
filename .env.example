# Copy this file to .env and adjust for your lab environment.
# Never commit a real .env file.

# --- General ---
ENVIRONMENT=lab
LOG_LEVEL=INFO

# --- Packet capture ---
# On the sensor VM (VirtualBox/VMware), find this with `ip link`.
# Typically the adapter attached to the internal/host-only network shared
# with the traffic-generator VM, NOT your bridged/NAT internet adapter.
CAPTURE_INTERFACE=eth0
CAPTURE_PROMISCUOUS=true
CAPTURE_QUEUE_MAX_SIZE=10000

# --- Flow aggregation ---
FLOW_TIMEOUT_SECONDS=120
FLOW_TABLE_MAX_SIZE=50000

# --- Database ---
DATABASE_URL=postgresql+psycopg://nids:nids@localhost:5432/nids

# --- ML ---
ML_MODEL_PATH=ml/models/latest_model.joblib
ML_FEATURE_SCHEMA_PATH=ml/models/feature_schema.json

# --- WebSocket ---
WEBSOCKET_BROADCAST_INTERVAL_MS=500

# --- Detection thresholds (nested via __ delimiter) ---
THRESHOLDS__PORT_SCAN_DISTINCT_PORTS=15
THRESHOLDS__PORT_SCAN_DISTINCT_PORTS_HIGH=40
THRESHOLDS__PORT_SCAN_WINDOW_SECONDS=10
THRESHOLDS__HIGH_CONN_RATE_PER_SEC=20.0
THRESHOLDS__SYN_FLOOD_RATIO_THRESHOLD=5.0
THRESHOLDS__PACKET_RATE_ZSCORE_THRESHOLD=3.0

# --- Risk scoring buckets ---
RISK_SCORING__LOW_MAX=29
RISK_SCORING__MEDIUM_MAX=59
RISK_SCORING__HIGH_MAX=79
